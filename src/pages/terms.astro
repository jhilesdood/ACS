---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Membership terms" description="ACS MMA membership terms: billing, cancellation and gym rules.">
  <PageHero title="Terms" lede="The terms you agree to when you join." />
  <section class="section">
    <div class="wrap prose">
      <h2>Billing</h2>
      <p class="tbd">TBD: billing day, failed payment handling, price changes.</p>
      <h2>Cancelling and pausing</h2>
      <p class="tbd">TBD: notice period, minimum term (if any), pausing for injury or travel, refunds.</p>
      <h2>Gym rules</h2>
      <p class="tbd">TBD: conduct, hygiene, sparring rules, guests.</p>
      <h2>Youth members</h2>
      <p class="tbd">TBD: guardian responsibilities, pick-up and drop-off, photo consent.</p>
    </div>
  </section>
</Base>
