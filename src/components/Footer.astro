---
import Logo from './Logo.astro';
import { getSite, nav, isTbd } from '../site';
const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="top">
      <a href="/" class="home"><Logo size="footer" /><span class="visually-hidden">ACS MMA home</span></a>
      <a href="/memberships" class="btn btn-red">See memberships</a>
    </div>

    <div class="cols">
      <div>
        <h2 class="h">Visit</h2>
        <p class:list={{ tbd: isTbd(site.address) }}>{site.address}</p>
        <p class:list={{ tbd: isTbd(site.city) }}>{site.city}</p>
      </div>
      <div>
        <h2 class="h">Hours</h2>
        <dl>
          {
            site.hours.map((h) => (
              <div>
                <dt>{h.days}</dt>
                <dd class:list={{ tbd: isTbd(h.time) }}>{h.time}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <nav aria-label="Footer">
        <h2 class="h">Train</h2>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/memberships">Memberships</a></li>
        </ul>
      </nav>
      <nav aria-label="About">
        <h2 class="h">The gym</h2>
        <ul>
          <li><a href="/coaches">Coaches</a></li>
          <li><a href="/the-gym">Our story</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/account">Manage membership</a></li>
        </ul>
      </nav>
    </div>

    <div class="legal">
      <p>&copy; {year} ACS MMA</p>
      <ul>
        <li><a href="/waiver">Waiver</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 6px solid var(--corner-red);
    padding-block: var(--space-xl) var(--space-l);
    font-size: 1rem;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-m);
    padding-bottom: var(--space-l);
    border-bottom: 1px solid var(--line);
  }
  .home {
    text-decoration: none;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-l) var(--space-m);
    padding-block: var(--space-l);
  }
  .h {
    margin-bottom: 0.75rem;
    font-size: 1rem;
    font-stretch: 100%;
    font-weight: 700;
    line-height: 1.3;
    color: var(--steel);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li a {
    display: inline-block;
    padding-block: 0.3rem;
    text-decoration: none;
  }
  li a:hover {
    text-decoration: underline;
    text-decoration-color: var(--corner-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  dl {
    margin: 0;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 16rem;
  }
  dd {
    margin: 0;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
    color: var(--steel);
    font-size: var(--step--1);
  }
  .legal ul {
    display: flex;
    gap: 1.25rem;
  }
</style>
