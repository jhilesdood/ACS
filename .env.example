# Copy to .env for local development. On Vercel, set these in Project Settings > Environment Variables.
# Every variable is optional: without them the site still runs and shows honest "not switched on yet" messages.

# Public site URL (used for canonical links, sitemap and share image)
SITE_URL=https://example.com

# Stripe: Developers > API keys (use sk_test_... until launch)
STRIPE_SECRET_KEY=
# Stripe: Developers > Webhooks > your endpoint (https://<domain>/api/stripe-webhook) > Signing secret
STRIPE_WEBHOOK_SECRET=

# Resend: API key, the gym inbox that receives messages, and a verified sender address
RESEND_API_KEY=
GYM_INBOX=
MAIL_FROM="ACS MMA <website@example.com>"

# Online waiver (Smartwaiver, WaiverForever, etc.) shown after checkout
PUBLIC_WAIVER_URL=
# Stripe: Settings > Billing > Customer portal > Login link (https://billing.stripe.com/p/login/...)
PUBLIC_PORTAL_LOGIN_URL=

# Keystatic in production: GitHub repo ("owner/repo") the CMS commits content edits to
PUBLIC_KEYSTATIC_GITHUB_REPO=
